<resources>
    <style name="Theme.WebTTS" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">#E50914</item>
        <item name="colorPrimaryDark">#B20710</item>
        <item name="colorAccent">#E50914</item>
        <item name="android:windowBackground">#111111</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
        <item name="alertDialogTheme">@style/Theme.WebTTS.Dialog</item>
        <!-- Nut gon mac dinh ca app (padding + chu nho) -->
        <item name="buttonStyle">@style/Widget.SubTTS.Button</item>
    </style>

    <style name="Theme.WebTTS.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="colorPrimary">#E50914</item>
        <item name="colorAccent">#E50914</item>
        <item name="android:windowBackground">#222222</item>
        <item name="android:textColorPrimary">#FFFFFF</item>
        <item name="android:textColorSecondary">#CCCCCC</item>
        <item name="buttonStyle">@style/Widget.SubTTS.Button</item>
    </style>

    <!-- Nut gon chung: thap + chu 12sp (textSize rieng van thang) -->
    <style name="Widget.SubTTS.Button" parent="Widget.AppCompat.Button">
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Widget.SubTTS.Button.Primary" parent="Widget.SubTTS.Button">
        <item name="android:backgroundTint">#E50914</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
